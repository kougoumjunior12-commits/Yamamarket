 pool.query( `UPDATE orders SET status = 'shipped', tracking_number = $1 WHERE id = $2 AND status <> 'delivered' RETURNING id, parcel_code`, [tracking, orderId] ); if (!rows[0]) return res.status(404).json({ error: 'Commande introuvable ou déjà livrée.' }); await pool.query( `INSERT INTO parcel_timeline (order_id, step_title, detail) VALUES ($1, 'Expédié', $2)`, [orderId, `Pris en charge par le transporteur (Suivi : ${tracking}). Fonds toujours en séquestre.`] ); res.json({ success: true }); }); // --- 6. VENDEUR : TENTER D'ENCAISSER (BLOQUÉ TANT QUE NON LIVRÉ) --- app.post('/api/orders/:id/payout', async (req, res) => { const orderId = Number(req.params.id); const { rows } = await pool.query('SELECT * FROM orders WHERE id = $1', [orderId]); const ord = rows[0]; if (!ord) return res.status(404).json({ error: 'Commande introuvable.' }); if (ord.status !== 'delivered') { return res.status(403).json({ error: 'Paiement bloqué : tant que le produit n’a pas été livré au client, le vendeur ne peut pas encaisser.' }); } if (ord.payout_released) { return res.status(409).json({ error: 'Ce montant a déjà été versé.' }); } await pool.query('UPDATE orders SET payout_released = TRUE, released_at = NOW() WHERE id = $1', [orderId]); res.json({ success: true, sellerNetEur: ord.seller_net_eur }); }); // --- 7. ADMIN (KOUKOUM JUNIOR) : CONFIRMER LA LIVRAISON --- app.patch('/api/admin/orders/:id/deliver', requireAdmin, async (req, res) => { const orderId = Number(req.params.id); const { rows } = await pool.query( `UPDATE orders SET status = 'delivered', delivered_at = NOW() WHERE id = $1 RETURNING id`, [orderId] ); if (!rows[0]) return res.status(404).json({ error: 'Commande introuvable.' }); await pool.query( `INSERT INTO parcel_timeline (order_id, step_title, detail) VALUES ($1, 'Livré', $2)`, [orderId, `Livraison confirmée par ${ADMIN_NAME}. Versement vendeur débloqué.`] ); res.json({ success: true }); }); // --- 8. ADMIN (KOUKOUM JUNIOR) : MODIFIER LE POURCENTAGE DE COMMISSION --- app.patch('/api/admin/stores/:id/commission', requireAdmin, async (req, res) => { const storeId = Number(req.params.id); const pct = Number(req.body.commissionPct); if (Number.isNaN(pct) || pct < 0 || pct > 80) { return res.status(400).json({ error: 'Pourcentage invalide (0 à 80%).' }); } await pool.query('UPDATE stores SET commission_pct = $1 WHERE id = $2', [pct, storeId]); res.json({ success: true }); }); // --- 9. MESSAGERIE PRIVÉE ACHETEUR <-> VENDEUR --- app.post('/api/conversations/:id/messages', async (req, res) => { const convId = Number(req.params.id); const senderLabel = String(req.body.senderLabel || 'Acheteur'); const cleanBody = maskPrivateInfo(req.body.body).trim(); if (!cleanBody) return res.status(400).json({ error: 'Message vide.' }); const { rows } = await pool.query( `INSERT INTO chat_messages (conversation_id, sender_label, body) VALUES ($1, $2, $3) RETURNING *`, [convId, senderLabel, cleanBody] ); res.status(201).json(rows[0]); }); app.post('/api/conversations/:id/flag', async (req, res) => { await pool.query('UPDATE conversations SET flagged = TRUE WHERE id = $1', [Number(req.params.id)]); res.json({ success: true }); }); // --- 10. SUPPORT ACTIF (RÉPONSE & ACTION IMMÉDIATE) --- app.post('/api/support', async (req, res) => { const { parcelCode, ticketType, description } = req.body; const code = String(parcelCode || '').trim().toUpperCase(); const ordRes = code ? await pool.query('SELECT * FROM orders WHERE parcel_code = $1', [code]) : await pool.query('SELECT * FROM orders ORDER BY id DESC LIMIT 1'); const ord = ordRes.rows[0]; let reply = `Demande enregistrée et transmise à ${ADMIN_NAME}.`; if (ord) { if (ticketType === 'payout_hold') { reply = ord.status !== 'delivered' ? `Diagnostic automatique (${ord.parcel_code}) : statut "${ord.status}". Tant que le colis n'est pas livré, votre part nette (${ord.seller_net_eur} €) reste bloquée en séquestre.` : `Colis ${ord.parcel_code} livré ! Votre gain net de ${ord.seller_net_eur} € est déblocable dans l'Espace Vendeur.`; } else if (ticketType === 'commission') { reply = `Calcul automatique (${ord.parcel_code}) : Brut = ${ord.gross_eur} € | Commission ${ADMIN_NAME} (${ord.commission_pct}%) = ${ord.admin_fee_eur} € | Net Vendeur = ${ord.seller_net_eur} €.`; } else if (ticketType === 'tracking') { const match = String(description || '').match(/\b[A-Z0-9]{6,22}\b/i); if (match && ord.status !== 'delivered') { const newTrack = match[0].toUpperCase(); await pool.query(`UPDATE orders SET tracking_number = $1, status = 'shipped' WHERE id = $2`, [newTrack, ord.id]); await pool.query(`INSERT INTO parcel_timeline (order_id, step_title, detail) VALUES ($1, 'Expédié', $2)`, [ord.id, `Suivi mis à jour via Support Actif : ${newTrack}`]); reply = `Numéro de suivi ${newTrack} enregistré sur ${ord.parcel_code}. Le paiement reste en séquestre jusqu'à livraison.`; } else { reply = `Suivi actuel de ${ord.parcel_code} : ${ord.tracking_number} (${ord.status}).`; } } } const { rows } = await pool.query( `INSERT INTO support_tickets (parcel_code, ticket_type, description, reply) VALUES ($1, $2, $3, $4) RETURNING *`, [ord ? ord.parcel_code : 'Général', ticketType, String(description || ''), reply] ); res.status(201).json(rows[0]); }); const PORT = process.env.PORT || 3000; app.listen(PORT, () => console.log(`Yama Shop API active sur http://localhost:${PORT}`)); 


