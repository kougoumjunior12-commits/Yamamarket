        </div>

        <div class="search-box">
            <select id="catSelect" onchange="renderMarket()">
                <option value="all">Toutes catégories</option>
                <option value="Électronique">Électronique</option>
                <option value="Maison & Déco">Maison & Déco</option>
                <option value="Mode & Accessoires">Mode & Accessoires</option>
                <option value="Beauté & Sport">Beauté & Sport</option>
            </select>
            <input type="text" id="searchInput" placeholder="Rechercher sur Yama Shop..." oninput="renderMarket()">
            <button onclick="renderMarket()">Rechercher</button>
        </div>

        <div class="header-controls">
            <select id="currencySelect" onchange="changeCurrency()">
                <option value="MAD">🇲🇦 MAD (DH)</option>
                <option value="EUR">🇪🇺 EUR (€)</option>
                <option value="USD">🇺🇸 USD ($)</option>
