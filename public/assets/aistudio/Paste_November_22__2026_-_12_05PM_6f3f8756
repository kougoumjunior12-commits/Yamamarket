        .btn-green { background: var(--success); color: #fff; border: none; padding: 7px 11px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; }
        .btn-green:disabled { background: #cbd5e1; color: #64748b; cursor: not-allowed; }
