            <button class="tab-btn" id="tab-seller" onclick="switchTab('seller')">Espace Vendeur</button>
            <button class="tab-btn" id="tab-messages" onclick="switchTab('messages')">Messagerie</button>
            <button class="tab-btn" id="tab-support" onclick="switchTab('support')">Support Actif</button>
            <button class="tab-btn" id="tab-admin" onclick="switchTab('admin')">Bilan Koukoum Junior</button>
