                            <option value="tracking">Problème numéro de suivi</option>
                        </select>
                        <input type="text" id="ticketParcelId" placeholder="Code colis (ex: CMD-12345-67)">
                        <input type="text" id="ticketDesc" placeholder="Décrivez le problème ou collez un numéro de suivi..." required>
                        <button type="submit" class="btn-primary">Analyser maintenant</button>
                    </form>
                    <div id="supportLiveBox"></div>
                </div>
                <div class="card">
                    <h3>Historique des résolutions</h3>
                    <div id="ticketsHistory"></div>
                </div>
            </div>
        </section>

        <!-- 5. ADMIN — KOUKOUM JUNIOR -->
        <section class="section" id="sec-admin">
            <div class="escrow-banner">
                <strong>Tableau de Bord Administrateur — Koukoum Junior :</strong> Bilan automatique des revenus, ajustement des commissions par boutique et confirmation de livraison pour débloquer les vendeurs.
            </div>
            <div class="kpi-grid" id="adminKpis"></div>

            <div class="card" style="margin-bottom:18px;">
                <h3>Bilan Automatique par Boutique</h3>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr><th>Boutique</th><th>Modèle</th><th>Commission (%)</th><th>CA Brut</th><th>Bénéfice Junior</th><th>Séquestre (Non livré)</th><th>Débloqué (Livré)</th><th>Action</th></tr>
                        </thead>
                        <tbody id="adminStoresBody"></tbody>
                    </table>
                </div>
            </div>

            <div class="card">
                <h3>Suivi Colis & Confirmation de Livraison</h3>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr><th>Colis</th><th>Boutique</th><th>Produit</th><th>Suivi</th><th>État</th><th>Paiement</th><th>Actions</th></tr>
                        </thead>
                        <tbody id="adminParcelsBody"></tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <!-- MODALE PANIER -->
    <div class="modal" id="cartModal">
        <div class="modal-card">
            <div style="display:flex;justify-content:space-between;margin-bottom:12px;">
                <h3>Panier Yama Shop</h3>
                <button class="btn-dark" onclick="closeModal('cartModal')">Fermer</button>
            </div>
            <div id="cartItemsList"></div>
            <div style="margin:12px 0;font-weight:800;">Total : <span id="cartTotalDisplay">0.00</span></div>
            <form onsubmit="placeOrder(event)">
                <input type="text" id="buyerCityInput" placeholder="Ville et pays de livraison (ex: Agadir, Maroc)" required>
                <button type="submit" class="btn-primary">Valider la commande</button>
            </form>
        </div>
    </div>

    <!-- MODALE SUIVI -->
    <div class="modal" id="trackModal">
        <div class="modal-card">
            <div style="display:flex;justify-content:space-between;margin-bottom:12px;">
                <h3 id="trackModalTitle">Suivi Colis</h3>
                <button class="btn-dark" onclick="closeModal('trackModal')">Fermer</button>
            </div>
            <div id="trackModalBody"></div>
        </div>
    </div>

    <script>
        const API_URL = 'http://localhost:3000/api';
        const CURRENCIES = {
            MAD: { symbol: 'MAD', rate: 10.8 },
            EUR: { symbol: '€', rate: 1 },
            USD: { symbol: '$', rate: 1.09 },
            GBP: { symbol: '£', rate: 0.85 },
            CAD: { symbol: 'CAD', rate: 1.48 },
            XOF: { symbol: 'CFA', rate: 655.96 }
        };

        let currency = 'MAD';
        let activeModeFilter = 'all';
        let currentRole = 'buyer';
        let adminPin = '';
        let activeConvId = null;

        let db = { adminName: 'Koukoum Junior', stores: [], products: [], orders: [], conversations: [], tickets: [] };
        let cart = JSON.parse(localStorage.getItem('yama_cart') || '[]');

        function formatMoney(eur) {
            const c = CURRENCIES[currency];
            return `${(Number(eur) * c.rate).toFixed(2)} ${c.symbol}`;
        }

        async function syncFromServer() {
            const res = await fetch(`${API_URL}/state`);
            if (!res.ok) return;
            db = await res.json();
            refreshAllViews();
        }

        function switchTab(tab) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.getElementById(`tab-${tab}`).classList.add('active');
            document.getElementById(`sec-${tab}`).classList.add('active');
            refreshAllViews();
        }

        function switchRole() {
            const chosen = document.getElementById('roleSelect').value;
            if (chosen === 'admin' && !adminPin) {
                const entered = prompt('Code PIN Administrateur (Koukoum Junior) :', 'junior2026');
                if (!entered) {
                    document.getElementById('roleSelect').value = currentRole;
                    return;
                }
                adminPin = entered;
            }
            currentRole = chosen;
            if (currentRole === 'seller') switchTab('seller');
            else if (currentRole === 'admin') switchTab('admin');
            else switchTab('market');
        }

        function changeCurrency() {
            currency = document.getElementById('currencySelect').value;
            refreshAllViews();
        }

        function setModeFilter(mode, btn) {
            activeModeFilter = mode;
            document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');
            renderMarket();
        }

        function renderMarket() {
            const q = document.getElementById('searchInput').value.trim().toLowerCase();
            const cat = document.getElementById('catSelect').value;
            const filtered = db.products.filter(p => {
                const okCat = cat === 'all' || p.category === cat;
                const okMode = activeModeFilter === 'all' || p.mode === activeModeFilter;
                const okQ = !q || p.title.toLowerCase().includes(q) || p.store_name.toLowerCase().includes(q);
                return okCat && okMode && okQ;
            });

            document.getElementById('marketGrid').innerHTML = filtered.map(p => {
                const bClass = p.mode === 'dropshipping' ? 'b-drop' : p.mode === 'flash' ? 'b-flash' : 'b-stock';
                const bLabel = p.mode === 'dropshipping' ? 'Dropshipping' : p.mode === 'flash' ? 'Vente Flash' : 'Stock';
                return `
                    <div class="card product-card">
                        <div>
                            <div class="product-thumb">${p.emoji || '📦'}</div>
                            <div style="display:flex;justify-content:space-between;margin:8px 0 4px;">
                                <span class="badge ${bClass}">${bLabel}</span>
                                <span style="font-size:11px;color:var(--muted);">Stock: ${p.stock}</span>
                            </div>
                            <div style="font-size:12px;color:var(--muted);">Boutique : <strong>${esc(p.store_name)}</strong></div>
                            <div style="font-size:12px;color:var(--muted);">✈️ ${esc(p.origin)}</div>
                            <div style="font-weight:700;margin-top:6px;">${esc(p.title)}</div>
                        </div>
                        <div>
                            <div>
                                <span class="price-main">${formatMoney(p.price_eur)}</span>
                                ${p.old_eur ? `<span class="price-old">${formatMoney(p.old_eur)}</span>` : ''}
                            </div>
                            <button class="btn-primary" style="margin-top:8px;" onclick="addToCart(${p.id})">Ajouter au panier</button>
                        </div>
                    </div>
                `;
            }).join('') || '<div class="card">Aucun produit disponible.</div>';
        }

        function addToCart(productId) {
            const p = db.products.find(x => x.id === productId);
            if (!p || p.stock <= 0) return alert('Rupture de stock.');
            const item = cart.find(i => i.productId === productId);
            if (item) item.qty += 1;
            else cart.push({ productId, qty: 1 });
            localStorage.setItem('yama_cart', JSON.stringify(cart));
            updateCartBadge();
        }

        function updateCartBadge() {
            document.getElementById('cartBadge').innerText = cart.reduce((s, i) => s + i.qty, 0);
        }

        function openCart() {
            let totalEur = 0;
            document.getElementById('cartItemsList').innerHTML = cart.map(i => {
                const p = db.products.find(x => x.id === i.productId);
                if (!p) return '';
                const line = Number(p.price_eur) * i.qty;
                totalEur += line;
                return `<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);font-size:13px;">
                    <span><strong>${esc(p.title)}</strong> × ${i.qty}</span><strong>${formatMoney(line)}</strong>
                </div>`;
            }).join('') || '<p style="font-size:13px;color:var(--muted);">Panier vide.</p>';
            document.getElementById('cartTotalDisplay').innerText = formatMoney(totalEur);
            document.getElementById('cartModal').classList.add('open');
        }

        async function placeOrder(e) {
            e.preventDefault();
            if (!cart.length) return alert('Panier vide.');
            const res = await fetch(`${API_URL}/orders`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: cart, buyerCity: document.getElementById('buyerCityInput').value })
            });
            const data = await res.json();
            if (!res.ok) return alert(data.error);
            cart = [];
            localStorage.setItem('yama_cart', '[]');
            updateCartBadge();
            closeModal('cartModal');
            alert('Commande validée en base de données ! Fonds bloqués en séquestre jusqu’à la livraison.');
            await syncFromServer();
        }

        async function saveStore(e) {
            e.preventDefault();
            const res = await fetch(`${API_URL}/stores`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    name: document.getElementById('storeNameInput').value,
                    logistics: document.getElementById('storeLogisticsInput').value
                })
            });
            const data = await res.json();
            if (!res.ok) return alert(data.error);
            e.target.reset();
            await syncFromServer();
            alert('Boutique enregistrée.');
        }

        async function publishProduct(e) {
            e.preventDefault();
            const res = await fetch(`${API_URL}/products`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    storeId: document.getElementById('prodStoreSelect').value,
                    title: document.getElementById('prodTitleInput').value,
                    category: document.getElementById('prodCatInput').value,
                    mode: document.getElementById('prodModeInput').value,
                    priceEur: document.getElementById('prodPriceInput').value,
                    stock: document.getElementById('prodStockInput').value,
                    origin: document.getElementById('prodOriginInput').value
                })
            });
            const data = await res.json();
            if (!res.ok) return alert(data.error);
            e.target.reset();
            await syncFromServer();
            alert('Produit publié sur Yama Shop.');
        }

        async function shipParcel(orderId) {
            const trackingNumber = prompt('Numéro de suivi du colis :', `YM${Math.floor(10000000 + Math.random() * 90000000)}`);
            if (!trackingNumber) return;
            const res = await fetch(`${API_URL}/orders/${orderId}/ship`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ trackingNumber })
            });
            if (!res.ok) return alert((await res.json()).error);
            await syncFromServer();
        }

        async function claimSellerPayout(orderId) {
            const res = await fetch(`${API_URL}/orders/${orderId}/payout`, { method: 'POST' });
            const data = await res.json();
            if (!res.ok) return alert(data.error);
            alert(`Versement effectué : ${formatMoney(data.sellerNetEur)}`);
            await syncFromServer();
        }

        async function confirmDeliveryAdmin(orderId) {
            const res = await fetch(`${API_URL}/admin/orders/${orderId}/deliver`, {
                method: 'PATCH',
                headers: { 'x-role': 'admin', 'x-admin-pin': adminPin }
            });
            const data = await res.json();
            if (!res.ok) return alert(data.error);
            await syncFromServer();
        }

        async function editStoreCommission(storeId, currentPct) {
            const val = prompt(`Nouveau pourcentage de commission pour ${db.adminName} (%) :`, currentPct);
            if (val === null) return;
            const res = await fetch(`${API_URL}/admin/stores/${storeId}/commission`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json', 'x-role': 'admin', 'x-admin-pin': adminPin },
                body: JSON.stringify({ commissionPct: Number(val) })
            });
            const data = await res.json();
            if (!res.ok) return alert(data.error);
            await syncFromServer();
        }

        function renderSellerView() {
            document.getElementById('prodStoreSelect').innerHTML = db.stores.map(s =>
                `<option value="${s.id}">${esc(s.name)} (${esc(s.logistics)})</option>`
            ).join('');

            let gross = 0, admin = 0, held = 0, unlocked = 0;
            db.orders.forEach(o => {
                gross += Number(o.gross_eur);
                admin += Number(o.admin_fee_eur);
                if (o.status !== 'delivered') held += Number(o.seller_net_eur);
                else unlocked += Number(o.seller_net_eur);
            });

            document.getElementById('sellerKpis').innerHTML = `
                <div class="card kpi"><small>Ventes Brutes</small><strong>${formatMoney(gross)}</strong></div>
                <div class="card kpi"><small>Commission ${db.adminName}</small><strong>${formatMoney(admin)}</strong></div>
                <div class="card kpi"><small>En Séquestre (Non livré)</small><strong style="color:var(--warn);">${formatMoney(held)}</strong></div>
                <div class="card kpi"><small>Débloqué (Livré)</small><strong style="color:var(--success);">${formatMoney(unlocked)}</strong></div>
            `;

            document.getElementById('sellerOrdersBody').innerHTML = db.orders.map(o => {
                const delivered = o.status === 'delivered';
                return `
                    <tr>
                        <td><strong>${esc(o.parcel_code)}</strong><br><small>${esc(o.tracking_number)}</small></td>
                        <td><strong>${esc(o.store_name)}</strong><br>${esc(o.product_title)} × ${o.qty}</td>
                        <td>${formatMoney(o.gross_eur)}</td>
                        <td>${formatMoney(o.admin_fee_eur)} (${o.commission_pct}%)</td>
                        <td><strong>${formatMoney(o.seller_net_eur)}</strong></td>
                        <td><span class="badge ${delivered ? 'b-delivered' : 'b-shipped'}">${delivered ? 'Livré' : o.status}</span></td>
                        <td><span class="badge ${o.payout_released || delivered ? 'b-delivered' : 'b-held'}">${o.payout_released ? 'Versé' : delivered ? 'Déblocable' : 'Bloqué'}</span></td>
                        <td style="display:flex;gap:6px;flex-wrap:wrap;">
                            <button class="btn-dark" onclick="openTracking(${o.id})">Suivi</button>
                            ${!delivered ? `<button class="btn-dark" onclick="shipParcel(${o.id})">Expédier</button>` : ''}
                            <button class="btn-green" ${(!delivered || o.payout_released) ? 'disabled' : ''} onclick="claimSellerPayout(${o.id})">
                                ${o.payout_released ? 'Payé' : delivered ? 'Encaisser' : 'Bloqué'}
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function renderAdminView() {
            let gmv = 0, profit = 0, held = 0, released = 0;
            db.orders.forEach(o => {
                gmv += Number(o.gross_eur);
                profit += Number(o.admin_fee_eur);
                if (o.status !== 'delivered') held += Number(o.seller_net_eur);
                else released += Number(o.seller_net_eur);
            });

            document.getElementById('adminKpis').innerHTML = `
                <div class="card kpi"><small>Volume Total Yama Shop</small><strong>${formatMoney(gmv)}</strong></div>
                <div class="card kpi"><small>Bénéfice Net ${db.adminName}</small><strong style="color:var(--success);">${formatMoney(profit)}</strong></div>
                <div class="card kpi"><small>Séquestre (Non livré)</small><strong style="color:var(--warn);">${formatMoney(held)}</strong></div>
                <div class="card kpi"><small>Débloqué (Livré)</small><strong>${formatMoney(released)}</strong></div>
            `;

            document.getElementById('adminStoresBody').innerHTML = db.stores.map(s => {
                const sOrders = db.orders.filter(o => o.store_id === s.id);
                const sGross = sOrders.reduce((sum, o) => sum + Number(o.gross_eur), 0);
                const sAdmin = sOrders.reduce((sum, o) => sum + Number(o.admin_fee_eur), 0);
                const sHeld = sOrders.filter(o => o.status !== 'delivered').reduce((sum, o) => sum + Number(o.seller_net_eur), 0);
                const sDone = sOrders.filter(o => o.status === 'delivered').reduce((sum, o) => sum + Number(o.seller_net_eur), 0);

                return `
                    <tr>
                        <td><strong>${esc(s.name)}</strong></td>
                        <td>${esc(s.logistics)}</td>
                        <td><strong>${s.commission_pct}%</strong></td>
                        <td>${formatMoney(sGross)}</td>
                        <td style="color:var(--success);font-weight:700;">${formatMoney(sAdmin)}</td>
                        <td>${formatMoney(sHeld)}</td>
                        <td>${formatMoney(sDone)}</td>
                        <td><button class="btn-dark" onclick="editStoreCommission(${s.id}, ${s.commission_pct})">Modifier %</button></td>
                    </tr>
                `;
            }).join('');

            document.getElementById('adminParcelsBody').innerHTML = db.orders.map(o => {
                const delivered = o.status === 'delivered';
                return `
                    <tr>
                        <td><strong>${esc(o.parcel_code)}</strong></td>
                        <td>${esc(o.store_name)}</td>
                        <td>${esc(o.product_title)} × ${o.qty}</td>
                        <td>${esc(o.tracking_number)}</td>
                        <td><span class="badge ${delivered ? 'b-delivered' : 'b-held'}">${delivered ? 'Livré' : 'Non livré'}</span></td>
                        <td>${o.payout_released ? 'Versé' : delivered ? 'Débloqué' : 'Bloqué'}</td>
                        <td style="display:flex;gap:6px;">
                            <button class="btn-dark" onclick="openTracking(${o.id})">Suivi</button>
                            ${!delivered ? `<button class="btn-green" onclick="confirmDeliveryAdmin(${o.id})">Confirmer Livraison</button>` : ''}
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function openTracking(orderId) {
            const o = db.orders.find(x => x.id === orderId);
            if (!o) return;
            document.getElementById('trackModalTitle').innerText = `Suivi ${o.parcel_code} — ${o.product_title}`;
            document.getElementById('trackModalBody').innerHTML = `
                <p style="font-size:13px;margin-bottom:10px;">
                    <strong>Destination :</strong> ${esc(o.buyer_city)} • <strong>Suivi :</strong> ${esc(o.tracking_number)}
                </p>
                ${(o.timeline || []).map(t => `
                    <div class="step-line"><strong>${esc(t.step_title)}</strong><br><span>${esc(t.detail)}</span></div>
                `).join('')}
            `;
            document.getElementById('trackModal').classList.add('open');
        }

        function renderConversations() {
            if (!activeConvId && db.conversations.length) activeConvId = db.conversations[0].id;
            document.getElementById('convList').innerHTML = db.conversations.map(c => `
                <div class="conv-item ${c.id === activeConvId ? 'active' : ''}" onclick="activeConvId=${c.id};renderConversations();">
                    <strong>${esc(c.store_name)}</strong><br>
                    <small>${esc(c.product_title)} (${esc(c.parcel_code)})</small>
                </div>
            `).join('');

            const conv = db.conversations.find(c => c.id === activeConvId);
            const flagBtn = document.getElementById('flagConvBtn');
            if (!conv) {
                document.getElementById('activeConvLabel').innerText = 'Aucune discussion';
                document.getElementById('chatMsgs').innerHTML = '';
                flagBtn.style.display = 'none';
                return;
            }
            document.getElementById('activeConvLabel').innerText = `${conv.store_name} — ${conv.parcel_code}` + (conv.flagged ? ' [Signalé]' : '');
            flagBtn.style.display = 'inline-block';

            const me = currentRole === 'seller' ? 'Vendeur' : currentRole === 'admin' ? db.adminName : 'Acheteur';
            document.getElementById('chatMsgs').innerHTML = (conv.messages || []).map(m => `
                <div class="bubble ${m.sender_label === me ? 'me' : 'other'}">
                    <div>${esc(m.body)}</div>
                    <small style="opacity:0.7;font-size:10px;">${esc(m.sender_label)}</small>
                </div>
            `).join('');
        }

        async function sendChatMsg(e) {
            e.preventDefault();
            if (!activeConvId) return;
            const senderLabel = currentRole === 'seller' ? 'Vendeur' : currentRole === 'admin' ? db.adminName : 'Acheteur';
            const input = document.getElementById('chatInput');
            await fetch(`${API_URL}/conversations/${activeConvId}/messages`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ senderLabel, body: input.value })
            });
            input.value = '';
            await syncFromServer();
        }

        async function flagCurrentConv() {
            if (!activeConvId) return;
            await fetch(`${API_URL}/conversations/${activeConvId}/flag`, { method: 'POST' });
            alert(`Signalé à ${db.adminName}.`);
            await syncFromServer();
        }

        async function submitSupportTicket(e) {
            e.preventDefault();
            const res = await fetch(`${API_URL}/support`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    parcelCode: document.getElementById('ticketParcelId').value,
                    ticketType: document.getElementById('ticketType').value,
                    description: document.getElementById('ticketDesc').value
                })
            });
            const data = await res.json();
            if (!res.ok) return alert(data.error);
            document.getElementById('supportLiveBox').innerHTML = `<div class="notice-box"><strong>Réponse active :</strong><br>${esc(data.reply)}</div>`;
            e.target.reset();
            await syncFromServer();
        }

        function renderTickets() {
            document.getElementById('ticketsHistory').innerHTML = db.tickets.map(t => `
                <div style="padding:10px 0;border-bottom:1px solid var(--border);font-size:13px;">
                    <strong>#${t.id} (${esc(t.parcel_code)})</strong> : ${esc(t.description)}
                    <div class="notice-box">${esc(t.reply)}</div>
                </div>
            `).join('');
        }

        function closeModal(id) { document.getElementById(id).classList.remove('open'); }
        function esc(s) { return String(s || '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m])); }

        function refreshAllViews() {
            updateCartBadge();
            renderMarket();
            renderSellerView();
            renderAdminView();
            renderConversations();
            renderTickets();
        }

        syncFromServer();
    </script>
</body>
</html>
